APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=khayaos
REVERB_APP_KEY=khayaos-local-key
REVERB_APP_SECRET=khayaos-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

REALTIME_WS_PUBLIC_HOST=localhost
REALTIME_WS_PUBLIC_PORT=8080
REALTIME_WS_SCHEME=ws
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@prohost.cloud"
MAIL_FROM_NAME="KhayaOS"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp notifications (Genius API default; Super Admin can also configure via /ops/platform/settings)
WHATSAPP_PROVIDER=genius
WHATSAPP_GENIUS_API_KEY=
WHATSAPP_GENIUS_SESSION_ID=
WHATSAPP_GENIUS_BASE_URL=https://restapi.geniusdevel.com
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=

# Web Push (generate with: php artisan webpush:vapid or openssl)
WEBPUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@khayaos.com

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Sanctum token TTL in minutes (7 days default)
SANCTUM_TOKEN_EXPIRATION=10080

# Frontend URL — used to build signup/welcome login links.
# MUST be set to the public site on production, e.g. https://khayaos.prohost.cloud
FRONTEND_URL=http://localhost:3000
